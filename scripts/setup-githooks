#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

echo "Setting up Git hooks for Layr..."

# Ensure hook scripts and tool scripts are executable
chmod +x "${REPO_ROOT}/.githooks/pre-commit"
for script in "${REPO_ROOT}/scripts"/*; do
  [ -f "${script}" ] && chmod +x "${script}"
done

# Configure Git to use version-controlled .githooks directory
git -C "${REPO_ROOT}" config core.hooksPath .githooks

# Also copy to .git/hooks as fallback
if [ -d "${REPO_ROOT}/.git/hooks" ]; then
  cp "${REPO_ROOT}/.githooks/pre-commit" "${REPO_ROOT}/.git/hooks/pre-commit"
  chmod +x "${REPO_ROOT}/.git/hooks/pre-commit"
fi

echo "Git hooks configured successfully (core.hooksPath = .githooks)."
