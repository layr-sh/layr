#!/usr/bin/env bash
set -euo pipefail

# Usage: ./scripts/sdk/spawn-test-server [flags] [services...] [-- <command...>]
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

LAYR__SERVER__LISTEN_ADDR=""
LAYR__DATABASE__URL=""
LAYR__SECURITY__MASTER_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
TIMEOUT=45
SERVICES=()
CMD=()
HAS_CMD=false

while [[ $# -gt 0 ]]; do
  if [[ "$1" == --port || "$1" == --data-dir || "$1" == --master-encryption-key || "$1" == --timeout ]]; then
    if [[ $# -lt 2 || "$2" == --* ]]; then
      echo "Error: $1 requires a value."
      exit 1
    fi
  fi
  case "$1" in
    --port=*)
      LAYR__SERVER__LISTEN_ADDR="127.0.0.1:${1#*=}"
      shift
      ;;
    --port)
      LAYR__SERVER__LISTEN_ADDR="127.0.0.1:$2"
      shift 2
      ;;
    --data-dir=*)
      LAYR__DATABASE__URL="${1#*=}"
      shift
      ;;
    --data-dir)
      LAYR__DATABASE__URL="$2"
      shift 2
      ;;
    --master-encryption-key=*)
      LAYR__SECURITY__MASTER_ENCRYPTION_KEY="${1#*=}"
      shift
      ;;
    --master-encryption-key)
      LAYR__SECURITY__MASTER_ENCRYPTION_KEY="$2"
      shift 2
      ;;
    --timeout=*)
      TIMEOUT="${1#*=}"
      shift
      ;;
    --timeout)
      TIMEOUT="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: ./scripts/sdk/spawn-test-server [flags] [services...] [-- <command...>]"
      echo ""
      echo "Flags:"
      echo "  --port=<port>                 Port number (default: auto ephemeral port)"
      echo "  --data-dir=<path>             Data directory (default: auto temp dir)"
      echo "  --master-encryption-key=<hex> 64-hex master encryption key (default: auto test key)"
      echo "  --timeout=<seconds>           Readiness probe timeout (default: 45)"
      echo "  -h, --help                    Show this help message"
      exit 0
      ;;
    --)
      HAS_CMD=true
      shift
      CMD=("$@")
      break
      ;;
    -*)
      echo "Error: unknown flag: $1"
      exit 1
      ;;
    *)
      SERVICES+=("$1")
      shift
      ;;
  esac
done

if [[ "${HAS_CMD}" == true && ${#CMD[@]} -eq 0 ]]; then
  echo "Error: No command specified after '--'"
  exit 1
fi
if [[ ! "${TIMEOUT}" =~ ^[0-9]+$ ]] || (( TIMEOUT <= 0 )); then
  echo "Error: timeout must be a positive number of seconds."
  exit 1
fi

if [[ -z "${LAYR__SERVER__LISTEN_ADDR}" ]]; then
  EPHEMERAL_PORT="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')"
  LAYR__SERVER__LISTEN_ADDR="127.0.0.1:${EPHEMERAL_PORT}"
fi
LAYR__SERVER__BASE_URL="http://${LAYR__SERVER__LISTEN_ADDR}"

RUN_DIR="$(mktemp -d "${TMPDIR:-/tmp}/layr-sdk-test-XXXXXX")"
LOG_FILE="${RUN_DIR}/server.log"
SERVER_PID=""

cleanup() {
  trap '' INT TERM
  if [[ -n "${SERVER_PID}" ]]; then
    if kill -0 "${SERVER_PID}" 2>/dev/null; then
      kill -TERM "${SERVER_PID}" 2>/dev/null || true
      for ((attempt = 0; attempt < 150; attempt++)); do
        if ! kill -0 "${SERVER_PID}" 2>/dev/null; then
          break
        fi
        sleep 0.1
      done
      if kill -0 "${SERVER_PID}" 2>/dev/null; then
        kill -KILL "${SERVER_PID}" 2>/dev/null || true
      fi
    fi
    wait "${SERVER_PID}" 2>/dev/null || true
  fi
  rm -rf "${RUN_DIR}"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ -z "${LAYR__DATABASE__URL}" ]]; then
  LAYR__DATABASE__URL="${RUN_DIR}/database"
elif [[ "${LAYR__DATABASE__URL}" != /* && "${LAYR__DATABASE__URL}" != *://* ]]; then
  LAYR__DATABASE__URL="${REPO_ROOT}/${LAYR__DATABASE__URL}"
fi

cd "${REPO_ROOT}"
go build -o "${RUN_DIR}/layr" ./cmd/layr

# Keep generated credentials and other runtime files outside the developer's workspace.
(
  cd "${RUN_DIR}"
  export LAYR__SERVER__LISTEN_ADDR LAYR__SERVER__BASE_URL LAYR__DATABASE__URL LAYR__SECURITY__MASTER_ENCRYPTION_KEY
  if [[ ${#SERVICES[@]} -gt 0 ]]; then
    exec "${RUN_DIR}/layr" up "${SERVICES[@]}"
  fi
  exec "${RUN_DIR}/layr" up
) > "${LOG_FILE}" 2>&1 &
SERVER_PID=$!

START_TIME="$(date +%s)"
READY=false
while true; do
  if ! kill -0 "${SERVER_PID}" 2>/dev/null; then
    echo "Error: Layr server exited prematurely. Server log:"
    cat "${LOG_FILE}"
    exit 1
  fi
  if curl -s -f -m 1 "${LAYR__SERVER__BASE_URL}/readyz" >/dev/null 2>&1; then
    READY=true
    break
  fi
  NOW="$(date +%s)"
  if (( NOW - START_TIME >= TIMEOUT )); then
    break
  fi
  sleep 0.1
done

if [[ "${READY}" != true ]]; then
  echo "Error: Layr server failed to become ready within ${TIMEOUT}s at ${LAYR__SERVER__BASE_URL}. Server log:"
  cat "${LOG_FILE}"
  exit 1
fi

if [[ "${HAS_CMD}" == true ]]; then
  if [[ -f "${RUN_DIR}/.layr/initial-root-account.txt" ]]; then
    LAYR__SERVICE_ACCOUNT_KEY="$(awk '/Service Account Key:/ { print $NF; exit }' "${RUN_DIR}/.layr/initial-root-account.txt")"
    export LAYR__SERVICE_ACCOUNT_KEY
  fi
  EXIT_CODE=0
  LAYR__SERVER__BASE_URL="${LAYR__SERVER__BASE_URL}" "${CMD[@]}" || EXIT_CODE=$?
  exit "${EXIT_CODE}"
fi

echo "Layr test server ready on ${LAYR__SERVER__BASE_URL}"
echo "Press Ctrl+C to stop."
wait "${SERVER_PID}"
