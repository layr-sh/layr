#!/usr/bin/env bash
set -euo pipefail

# scripts/sdk/spawn-test-server
# Global Test Server automation harness for Layr client SDKs.
#
# Usage:
#   ./scripts/sdk/spawn-test-server [flags] [services...] -- <test-command...>
#   ./scripts/sdk/spawn-test-server [flags] [services...]
#
# Flags:
#   --port=<port>                     Port number (default: auto ephemeral port)
#   --data-dir=<path>                 Data directory (default: auto temp dir)
#   --master-encryption-key=<hex>     64-hex master encryption key (default: auto test key)
#   --timeout=<seconds>               Readiness probe timeout (default: 45)
#   -h, --help                        Show this help message

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

LAYR__SERVER__LISTEN_ADDR=""
LAYR__DATABASE__URL=""
LAYR__SECURITY__MASTER_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
TIMEOUT=45
SERVICES=()
CMD=()
HAS_CMD=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --port=*)
      LAYR__SERVER__LISTEN_ADDR="127.0.0.1:${1#*=}"
      shift
      ;;
    --port)
      LAYR__SERVER__LISTEN_ADDR="127.0.0.1:$2"
      shift 2
      ;;
    --data-dir=*)
      LAYR__DATABASE__URL="${1#*=}"
      shift
      ;;
    --data-dir)
      LAYR__DATABASE__URL="$2"
      shift 2
      ;;
    --master-encryption-key=*)
      LAYR__SECURITY__MASTER_ENCRYPTION_KEY="${1#*=}"
      shift
      ;;
    --master-encryption-key)
      LAYR__SECURITY__MASTER_ENCRYPTION_KEY="$2"
      shift 2
      ;;
    --timeout=*)
      TIMEOUT="${1#*=}"
      shift
      ;;
    --timeout)
      TIMEOUT="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: ./scripts/sdk/spawn-test-server [flags] [services...] [-- <command...>]"
      echo ""
      echo "Flags:"
      echo "  --port=<port>                 Port number (default: auto ephemeral port)"
      echo "  --data-dir=<path>             Data directory (default: auto temp dir)"
      echo "  --master-encryption-key=<hex> 64-hex master encryption key (default: auto test key)"
      echo "  --timeout=<seconds>           Readiness probe timeout (default: 45)"
      echo "  -h, --help                    Show this help message"
      exit 0
      ;;
    --)
      HAS_CMD=true
      shift
      CMD=("$@")
      break
      ;;
    *)
      SERVICES+=("$1")
      shift
      ;;
  esac
done

# Allocate free ephemeral port if listen address not provided
if [[ -z "${LAYR__SERVER__LISTEN_ADDR}" ]]; then
  EPHEMERAL_PORT="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')"
  LAYR__SERVER__LISTEN_ADDR="127.0.0.1:${EPHEMERAL_PORT}"
fi

LAYR__SERVER__BASE_URL="http://${LAYR__SERVER__LISTEN_ADDR}"

# Allocate temporary database directory if not provided
TEMP_DB=false
if [[ -z "${LAYR__DATABASE__URL}" ]]; then
  TEMP_DB=true
  LAYR__DATABASE__URL="$(mktemp -d "${TMPDIR:-/tmp}/layr-test-XXXXXX")"
fi

LOG_FILE="$(mktemp "${TMPDIR:-/tmp}/layr-test-log-XXXXXX")"

cd "${REPO_ROOT}"

# Launch Layr server
if [[ "${#SERVICES[@]}" -gt 0 ]]; then
  LAYR__SERVER__LISTEN_ADDR="${LAYR__SERVER__LISTEN_ADDR}" \
  LAYR__SERVER__BASE_URL="${LAYR__SERVER__BASE_URL}" \
  LAYR__DATABASE__URL="${LAYR__DATABASE__URL}" \
  LAYR__SECURITY__MASTER_ENCRYPTION_KEY="${LAYR__SECURITY__MASTER_ENCRYPTION_KEY}" \
  go run ./cmd/layr up "${SERVICES[@]}" > "${LOG_FILE}" 2>&1 &
else
  LAYR__SERVER__LISTEN_ADDR="${LAYR__SERVER__LISTEN_ADDR}" \
  LAYR__SERVER__BASE_URL="${LAYR__SERVER__BASE_URL}" \
  LAYR__DATABASE__URL="${LAYR__DATABASE__URL}" \
  LAYR__SECURITY__MASTER_ENCRYPTION_KEY="${LAYR__SECURITY__MASTER_ENCRYPTION_KEY}" \
  go run ./cmd/layr up > "${LOG_FILE}" 2>&1 &
fi

SERVER_PID=$!

cleanup() {
  if kill -0 "${SERVER_PID}" 2>/dev/null; then
    pkill -P "${SERVER_PID}" 2>/dev/null || true
    kill -TERM "${SERVER_PID}" 2>/dev/null || true
    sleep 0.2
    if kill -0 "${SERVER_PID}" 2>/dev/null; then
      kill -KILL "${SERVER_PID}" 2>/dev/null || true
    fi
  fi
  if [[ "${TEMP_DB}" == "true" && -d "${LAYR__DATABASE__URL}" ]]; then
    rm -rf "${LAYR__DATABASE__URL}"
  fi
  rm -f "${LOG_FILE}"
}

trap cleanup EXIT INT TERM

# Poll readiness probe
START_TIME="$(date +%s)"
READY=false

while true; do
  if ! kill -0 "${SERVER_PID}" 2>/dev/null; then
    echo "Error: Layr server exited prematurely. Server log:"
    cat "${LOG_FILE}"
    exit 1
  fi

  if curl -s -f -m 1 "${LAYR__SERVER__BASE_URL}/v1/manifest" >/dev/null 2>&1; then
    READY=true
    break
  fi

  NOW="$(date +%s)"
  if (( NOW - START_TIME >= TIMEOUT )); then
    break
  fi
  sleep 0.1
done

if [[ "${READY}" != "true" ]]; then
  echo "Error: Layr server failed to become ready within ${TIMEOUT}s at ${LAYR__SERVER__BASE_URL}. Server log:"
  cat "${LOG_FILE}"
  exit 1
fi

if [[ "${HAS_CMD}" == "true" ]]; then
  if [[ "${#CMD[@]}" -eq 0 ]]; then
    echo "Error: No command specified after '--'"
    exit 1
  fi

  EXIT_CODE=0
  set +e
  LAYR__SERVER__BASE_URL="${LAYR__SERVER__BASE_URL}" "${CMD[@]}"
  EXIT_CODE=$?
  set -e

  exit "${EXIT_CODE}"
else
  echo "Layr test server ready on ${LAYR__SERVER__BASE_URL}"
  echo "Press Ctrl+C to stop."
  wait "${SERVER_PID}"
fi
