#!/usr/bin/env bash
set -euo pipefail

# scripts/sdk/generate
# Generate independent base and control plane SDKs for each service.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"

cd "${ROOT_DIR}"

SDK_DIR="./client-sdk"
SPEC_ROOT="generated/openapi"

TARGET=all

while [[ $# -gt 0 ]]; do
  case "$1" in
    --target)
      if [[ $# -lt 2 || "$2" == --* ]]; then
        echo "Error: --target requires a value (js, python, go, rust, swift, or all)."
        exit 1
      fi
      TARGET="$2"
      shift 2
      ;;
    --target=*)
      TARGET="${1#*=}"
      shift
      ;;
    --output-dir=*)
      SDK_DIR="${1#*=}"
      shift
      ;;
    --spec-dir=*)
      SPEC_ROOT="${1#*=}"
      shift
      ;;
    -h|--help)
      echo "Usage: $0 [--target <js|python|go|rust|swift|all>] [--output-dir=<sdk-dir>] [--spec-dir=<spec-dir>]"
      exit 0
      ;;
    *)
      echo "Error: unknown flag: $1"
      echo "Usage: $0 [--target <js|python|go|rust|swift|all>] [--output-dir=<sdk-dir>] [--spec-dir=<spec-dir>]"
      exit 1
      ;;
  esac
done

case "${TARGET}" in
  js|python|go|rust|swift|all) ;;
  *)
    echo "Error: invalid target '${TARGET}'. Expected js, python, go, rust, swift, or all."
    exit 1
    ;;
esac

if [[ -z "${SDK_DIR}" || -z "${SPEC_ROOT}" ]]; then
  echo "Error: output and spec directories must not be empty."
  exit 1
fi

echo "==> Step 1: Exporting & Validating OpenAPI 3.1 Specifications..."
./scripts/sdk/generate-openapi-specs --output-dir="${SPEC_ROOT}"

if [[ "${TARGET}" == all || "${TARGET}" == js ]]; then rm -rf "${SDK_DIR}/javascript/generated"; fi
if [[ "${TARGET}" == all || "${TARGET}" == python ]]; then rm -rf "${SDK_DIR}/python/generated"; fi
if [[ "${TARGET}" == all || "${TARGET}" == go ]]; then rm -rf "${SDK_DIR}/go/generated"; fi
if [[ "${TARGET}" == all || "${TARGET}" == rust ]]; then rm -rf "${SDK_DIR}/rust/generated"; fi
if [[ "${TARGET}" == all || "${TARGET}" == swift ]]; then rm -rf "${SDK_DIR}/swift/generated"; fi

clean_cruft() {
  local target_dir="$1"
  rm -rf "${target_dir}/.openapi-generator"
  rm -f "${target_dir}/.openapi-generator-ignore"
  if [[ "${target_dir}" == *"generated"* ]]; then
    rm -f "${target_dir}/.gitignore"
  fi
  rm -f "${target_dir}/.travis.yml"
  rm -f "${target_dir}/git_push.sh"
}

for SPEC_DIR in "${SPEC_ROOT}"/*/; do
  SERVICE="$(basename "${SPEC_DIR}")"
  for PLANE in base control_plane; do
    SPEC_FILE="${SPEC_DIR}${PLANE//_/-}-spec.json"

    # 1. JavaScript / TypeScript Target
    if [[ "${TARGET}" == all || "${TARGET}" == js ]]; then
      OUT_DIR="${SDK_DIR}/javascript/generated/${SERVICE}/${PLANE}"
      echo "==> Generating JavaScript / TypeScript SDK (typescript-fetch) -> ${OUT_DIR}..."
      mkdir -p "${OUT_DIR}"
      npx -y @openapitools/openapi-generator-cli generate \
        -i "${SPEC_FILE}" \
        -g typescript-fetch \
        -o "${OUT_DIR}" \
        --additional-properties=supportsES6=true,typescriptThreePlus=true
      clean_cruft "${OUT_DIR}"
      echo "JavaScript / TypeScript SDK generated successfully."
    fi

    # 2. Python Target
    if [[ "${TARGET}" == all || "${TARGET}" == python ]]; then
      OUT_DIR="${SDK_DIR}/python/generated/${SERVICE}/${PLANE}"
      echo "==> Generating Python SDK (python) -> ${OUT_DIR}..."
      mkdir -p "${OUT_DIR}"
      npx -y @openapitools/openapi-generator-cli generate \
        -i "${SPEC_FILE}" \
        -g python \
        -o "${SDK_DIR}/python" \
        --additional-properties="packageName=generated.${SERVICE}.${PLANE},generateSourceCodeOnly=true"
      clean_cruft "${OUT_DIR}"
      clean_cruft "${SDK_DIR}/python"
      rm -rf "${SDK_DIR}/python/generated_README.md" "${OUT_DIR}/docs" "${OUT_DIR}/test"
      echo "Python SDK generated successfully."
    fi

    # 3. Go Target
    if [[ "${TARGET}" == all || "${TARGET}" == go ]]; then
      OUT_DIR="${SDK_DIR}/go/generated/${SERVICE}/${PLANE}"
      echo "==> Generating Go SDK (go) -> ${OUT_DIR}..."
      mkdir -p "${OUT_DIR}"
      npx -y @openapitools/openapi-generator-cli generate \
        -i "${SPEC_FILE}" \
        -g go \
        -o "${OUT_DIR}" \
        --additional-properties="packageName=${PLANE},isGoSubmodule=true"
      clean_cruft "${OUT_DIR}"
      rm -f "${OUT_DIR}/go.mod" "${OUT_DIR}/go.sum" "${OUT_DIR}/README.md"
      rm -rf "${OUT_DIR}/docs" "${OUT_DIR}/test"
      echo "Go SDK generated successfully."
    fi

    # 4. Rust Target
    if [[ "${TARGET}" == all || "${TARGET}" == rust ]]; then
      OUT_DIR="${SDK_DIR}/rust/generated/${SERVICE}/${PLANE}"
      echo "==> Generating Rust SDK (rust) -> ${OUT_DIR}..."
      mkdir -p "${OUT_DIR}"
      npx -y @openapitools/openapi-generator-cli generate \
        -i "${SPEC_FILE}" \
        -g rust \
        -o "${OUT_DIR}" \
        --additional-properties=packageName=generated
      clean_cruft "${OUT_DIR}"
      if [[ "$(uname)" == "Darwin" ]]; then
        sed -i '' -E 's/\{([a-zA-Z0-9_]+)\.\.\.\}/{\1}/g' "${OUT_DIR}/src/apis/"*.rs
        sed -i '' -E 's/([a-zA-Z0-9_]+)\.\.\.=/ \1=/g' "${OUT_DIR}/src/apis/"*.rs
      else
        sed -i -E 's/\{([a-zA-Z0-9_]+)\.\.\.\}/{\1}/g' "${OUT_DIR}/src/apis/"*.rs
        sed -i -E 's/([a-zA-Z0-9_]+)\.\.\.=/ \1=/g' "${OUT_DIR}/src/apis/"*.rs
      fi
      echo "Rust SDK generated successfully."
    fi

    # 5. Swift Target
    if [[ "${TARGET}" == all || "${TARGET}" == swift ]]; then
      OUT_DIR="${SDK_DIR}/swift/generated/${SERVICE}/${PLANE}"
      echo "==> Generating Swift SDK (swift6) -> ${OUT_DIR}..."
      mkdir -p "${OUT_DIR}"
      npx -y @openapitools/openapi-generator-cli generate \
        -i "${SPEC_FILE}" \
        -g swift6 \
        -o "${OUT_DIR}" \
        --additional-properties=projectName=Generated,responseAs=AsyncAwait
      clean_cruft "${OUT_DIR}"
      echo "Swift SDK generated successfully."
    fi
  done
done

echo "All requested SDKs generated successfully from independent service specifications."
