#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}"

REBUILD=false
QUIET=false
PASSTHROUGH_ARGS=()
PACKAGES=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      echo "Usage: $(basename "$0") [options] [packages...]"
      echo ""
      echo "Runs custom-gcl (golangci-lint with custom linters) across repository packages."
      echo ""
      echo "Options:"
      echo "  --rebuild     Rebuild the custom-gcl binary before linting"
      echo "  --fix         Automatically fix supported linter issues"
      echo "  -v, --verbose Enable verbose linter output"
      echo "  -q, --quiet   Suppress output on success (only print issues)"
      echo "  -h, --help    Show this help message"
      echo ""
      echo "Examples:"
      echo "  ./scripts/lint             # Lint all packages in the repository"
      echo "  ./scripts/lint --fix       # Automatically fix autofixable issues"
      echo "  ./scripts/lint ./core/...  # Lint specific package subtree"
      echo "  ./scripts/lint --rebuild   # Rebuild custom-gcl binary and lint"
      exit 0
      ;;
    --rebuild)
      REBUILD=true
      shift
      ;;
    --fix)
      PASSTHROUGH_ARGS+=("--fix")
      shift
      ;;
    -v|--verbose)
      PASSTHROUGH_ARGS+=("-v")
      shift
      ;;
    -q|--quiet)
      QUIET=true
      shift
      ;;
    -*)
      PASSTHROUGH_ARGS+=("$1")
      shift
      ;;
    *)
      PACKAGES+=("$1")
      shift
      ;;
  esac
done

CUSTOM_GCL="${REPO_ROOT}/custom-gcl"

if [ "${REBUILD}" = true ] || [ ! -x "${CUSTOM_GCL}" ]; then
  if ! command -v golangci-lint >/dev/null 2>&1; then
    echo "error: custom-gcl binary not found at ${CUSTOM_GCL} and golangci-lint is not installed to build it." >&2
    exit 1
  fi
  if [ "${QUIET}" = true ]; then
    golangci-lint custom >/dev/null 2>&1 || {
      echo "error: failed to build custom-gcl binary." >&2
      golangci-lint custom
      exit 1
    }
  else
    echo "Building custom-gcl binary..."
    golangci-lint custom
  fi
fi

if [ ${#PACKAGES[@]} -eq 0 ]; then
  PACKAGES=("./...")
fi

CMD=("${CUSTOM_GCL}" run)
if [ ${#PASSTHROUGH_ARGS[@]} -gt 0 ]; then
  CMD+=("${PASSTHROUGH_ARGS[@]}")
fi
CMD+=("${PACKAGES[@]}")

if [ "${QUIET}" = true ]; then
  if ! "${CMD[@]}" >/dev/null 2>&1; then
    "${CMD[@]}"
    exit 1
  fi
  exit 0
fi

"${CMD[@]}"
