#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
CACHE_BIN="${REPO_ROOT}/.cache/bin/check_test_names"
SRC="${SCRIPT_DIR}/src/check_test_names.go"

# Compile binary if not present or if the source file is newer
if [ ! -f "${CACHE_BIN}" ] || [ "${SRC}" -nt "${CACHE_BIN}" ]; then
  mkdir -p "$(dirname "${CACHE_BIN}")"
  go build -o "${CACHE_BIN}" "${SRC}"
fi

exec "${CACHE_BIN}" "$@"
