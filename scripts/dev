#!/usr/bin/env bash

# Keep terminal interrupts out of the package-manager/child process tree. The
# supervisor owns shutdown and signals each root process once; pnpm forwards it
# to Nuxt, which then closes its own workers gracefully.
run_dev() {
    local server_pid ui_pid pid status child_status
    status=0
    server_pid=
    ui_pid=

    shutdown() {
        trap '' INT TERM
        status=$1
        for pid in "$server_pid" "$ui_pid"; do
            if [[ -n "$pid" ]]; then
                kill -TERM "$pid" 2>/dev/null || true
            fi
        done
        for pid in "$server_pid" "$ui_pid"; do
            if [[ -n "$pid" ]]; then
                wait "$pid"
                child_status=$?
                if [[ "$status" -eq 0 && "$child_status" -ne 0 ]]; then
                    status=$child_status
                fi
            fi
        done
        exit "$status"
    }
    trap 'shutdown 0' INT TERM

    # Job control gives each service its own process group, separate from the
    # foreground supervisor. Disable notifications once the groups are created.
    set -m
    ./dev-server up </dev/null &
    server_pid=$!
    pnpm --dir ui/console run dev </dev/null &
    ui_pid=$!
    set +m

    while true; do
        for pid in "$server_pid" "$ui_pid"; do
            if ! kill -0 "$pid" 2>/dev/null; then
                wait "$pid"
                status=$?
                shutdown "$status"
            fi
        done
        sleep 0.2 &
        wait $!
    done
}

if [[ -t 0 ]]; then
    # Give the supervisor the terminal while it runs, so Ctrl-C does not also
    # interrupt the outer just process. fg restores terminal ownership on exit.
    set -m
    run_dev &
    fg %1 >/dev/null
else
    run_dev
fi
