  "info": {
    "description": "Protected Control Plane APIs for Layr Platform",
    "title": "Layr Control Plane API Engine",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/_/core/event-hooks": {
      "get": {
        "description": "Lists event hook subscriptions from core.event_hooks with driver (sql or http), target function or URL, subscribed event type patterns, retry limits, and enabled status. Requires core:event-hook.read scope.",
        "operationId": "core__event_hooks__list",
        "parameters": [
          {
            "description": "Filter event hooks by delivery driver ('sql' or 'http')",
            "in": "query",
            "name": "driver",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter event hooks by active enabled status",
            "in": "query",
            "name": "is_enabled",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EventHook"
                  },
                  "type": "array"
                }
              },
              "application/xml": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EventHook"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "List event hook subscriptions",
        "tags": [
          "Event Hooks"
        ],
        "x-sdk-group-name": [
          "core",
          "event_hooks"
        ],
        "x-sdk-method-name": "list"
      },
      "post": {
        "description": "Creates an event hook subscription in core.event_hooks for SQL stored procedures (sql driver) or HTTP webhooks (http driver) with HMAC-SHA256 signing secret encryption, wildcard event patterns, timeout guards, and retry policies. Requires core:event-hook.write scope.",
        "operationId": "core__event_hooks__create",
        "requestBody": {
          "content": {
            "*/*": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventHookInput"
              }
            }
          },
          "description": "Request body for core.CreateEventHookInput",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventHook"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/EventHook"
                }
              }
            },
            "description": "Created"
          }
        },
        "summary": "Create an event hook subscription",
        "tags": [
          "Event Hooks"
        ],
        "x-sdk-group-name": [
          "core",
          "event_hooks"
        ],
        "x-sdk-method-name": "create"
      }
    },
    "/v1/_/core/event-hooks/{event_hook_id}": {
      "delete": {
        "description": "Permanently removes an event hook subscription from core.event_hooks, immediately unbinding event dispatches. Delivery history is preserved or cascaded according to retention rules. Requires core:event-hook.write scope.",
        "operationId": "core__event_hooks__delete",
        "parameters": [
          {
            "in": "path",
            "name": "event_hook_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Empty"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Empty"
                }
              }
            },
            "description": "OK"
          },
          "204": {
            "description": "Event hook deleted"
          }
        },
        "summary": "Delete event hook subscription",
        "tags": [
          "Event Hooks"
        ],
        "x-sdk-group-name": [
          "core",
          "event_hooks"
        ],
        "x-sdk-method-name": "delete"
      },
      "get": {
        "description": "Retrieves event hook configuration by UUID from core.event_hooks, including driver type, target endpoint, subscribed event patterns, retry limits, and secret configuration indicator. Requires core:event-hook.read scope.",
        "operationId": "core__event_hooks__get",
        "parameters": [
          {
            "in": "path",
            "name": "event_hook_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventHook"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/EventHook"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Get event hook subscription details by UUID",
        "tags": [
          "Event Hooks"
        ],
        "x-sdk-group-name": [
          "core",
          "event_hooks"
        ],
        "x-sdk-method-name": "get"
      },
      "put": {
        "description": "Modifies event hook parameters in core.event_hooks including target URL or stored procedure, subscribed event patterns, retry count (0-10), timeout (1-60s), signing secret, or enabled status. Requires core:event-hook.write scope.",
        "operationId": "core__event_hooks__update",
        "parameters": [
          {
            "in": "path",
            "name": "event_hook_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "*/*": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEventHookInput"
              }
            }
          },
          "description": "Request body for core.UpdateEventHookInput",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventHook"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/EventHook"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Update event hook subscription",
        "tags": [
          "Event Hooks"
        ],
        "x-sdk-group-name": [
          "core",
          "event_hooks"
        ],
        "x-sdk-method-name": "update"
      }
    },
    "/v1/_/core/event-hooks/{event_hook_id}/deliveries": {
      "get": {
        "description": "Queries the 100 most recent dispatch attempts for an event hook from core.event_hook_deliveries, detailing event ID, payload, HTTP status code, duration in milliseconds, error messages, and delivery state. Requires core:event-hook.read scope.",
        "operationId": "core__event_hooks__deliveries__list",
        "parameters": [
          {
            "in": "path",
            "name": "event_hook_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EventHookDelivery"
                  },
                  "type": "array"
                }
              },
              "application/xml": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EventHookDelivery"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "List delivery audit logs for an event hook",
        "tags": [
          "Event Hooks Deliveries"
        ],
        "x-sdk-group-name": [
          "core",
          "event_hooks",
          "deliveries"
        ],
        "x-sdk-method-name": "list"
      }
    },
    "/v1/_/core/event-hooks/{event_hook_id}/deliveries/{delivery_id}/retry": {
      "post": {
        "description": "Manually redrives an event hook delivery using the recorded event payload, re-dispatching via the configured driver (SQL procedure or HTTP POST webhook) and recording the new attempt outcome. Requires core:event-hook.write scope.",
        "operationId": "core__event_hooks__deliveries__retry",
        "parameters": [
          {
            "in": "path",
            "name": "event_hook_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "delivery_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "*/*": {
              "schema": {
                "$ref": "#/components/schemas/Empty"
              }
            }
          },
          "description": "Request body for core.Empty",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventHookDelivery"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/EventHookDelivery"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Retry a past event hook delivery attempt",
        "tags": [
          "Event Hooks Deliveries"
        ],
        "x-sdk-group-name": [
          "core",
          "event_hooks",
          "deliveries"
        ],
        "x-sdk-method-name": "retry"
      }
    },
    "/v1/_/core/events": {
      "get": {
        "description": "Queries immutable system and domain events from core.events with multi-field filtering by event type, actor type, date ranges, and pagination limits. Returns full event context, actor, and payload data. Requires core:event.read scope.",
        "operationId": "core__events__list",
        "parameters": [
          {
            "description": "Maximum number of items to return (default 50, maximum 1000)",
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "type": "integer"
            }
          },
          {
            "description": "Number of items to skip before returning results (default 0)",
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "type": "integer"
            }
          },
          {
            "description": "Filter by specific event type name",
            "in": "query",
            "name": "type",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by actor principal type (user, service_account, system)",
            "in": "query",
            "name": "actor_type",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by actor principal UUID",
            "in": "query",
            "name": "actor_id",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by target resource entity type",
            "in": "query",
            "name": "resource_type",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by target resource unique identifier",
            "in": "query",
            "name": "resource_id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListEventsResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ListEventsResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Query immutable system and domain audit events",
        "tags": [
          "Events"
        ],
        "x-sdk-group-name": [
          "core",
          "events"
        ],
        "x-sdk-method-name": "list"
      }
    },
